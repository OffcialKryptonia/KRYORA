# Add one TMDB credential in Vercel → Project → Settings → Environment Variables.
# Prefer the v4 Read Access Token; keep it server-side (never prefix with NEXT_PUBLIC_).
TMDB_API_READ_ACCESS_TOKEN=
# Alternatively, a TMDB v3 API key:
# TMDB_API_KEY=

# MovieBox integration service (server-only; configure Preview first).
# Must be the HTTPS base URL of a service you control or are authorised to use.
MOVIEBOX_PARTNER_API_BASE_URL=
# Optional bearer token issued for this integration. Never use NEXT_PUBLIC_.
MOVIEBOX_PARTNER_API_TOKEN=
